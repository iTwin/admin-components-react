{
  "stylelint.autoFixOnSave": true,
  "eslint.validate": [
    "typescript",
    "typescriptreact",
    "javascript",
    "javascriptreact"
  ],
  "files.exclude": {
    "obj": true,
    "bin": true
  },
  "search.exclude": {
    "**/CHANGELOG.md": true
  },
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": ["^@mui/[^/]+$"],
  "jest.virtualFolders": [
